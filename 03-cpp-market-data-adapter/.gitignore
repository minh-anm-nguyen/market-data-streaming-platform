# Build output normally lives outside the tree (scripts/env.sh sets
# P03_BUILD_ROOT), but keep these out in case someone configures in place.
build/
build-*/
out/

# Generated by tools/make_fixtures.py. The generator is the source; these
# are reproducible from it.
fixtures/
__pycache__/
*.pyc

# CI artifacts. A report is evidence of one run on one machine, not
# something to commit as a standing claim.
reports/*
!reports/.gitkeep
